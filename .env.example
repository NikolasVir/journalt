# JournalT Environment Configuration Example
# Copy to .env or configure in systemd / container environment

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5050

# Authentication Configuration (set to true initially to register first user)
Auth__RegistrationEnabled=false

# Storage Configuration
# SQLite connection string or directory (use Data Source=/data/journalt.db in Docker)
ConnectionStrings__DefaultConnection=Data Source=journalt.db

