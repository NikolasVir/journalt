# JournalT Environment Configuration Example
# Copy to .env or configure in systemd / container environment

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5050

# JWT Configuration
# Generate a secure 256-bit+ random secret for production
JWT_SECRET=ReplaceWithYourSecureRandomSecretKeyOfAtLeast32Chars!
JWT_ISSUER=JournalT
JWT_AUDIENCE=JournalT

# Storage Configuration
# SQLite connection string or directory
ConnectionStrings__DefaultConnection=Data Source=journalt.db;
