meta {
  name: Create Closed Tag Definition
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tags/definitions
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "category": "status",
    "allowedValuesJson": "[\"draft\", \"in-review\", \"published\"]"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("tagDefinitionId", res.body.id);
  }
}

docs {
  Defines a global tag category with a closed vocabulary constraint (TYPE-004).
}
