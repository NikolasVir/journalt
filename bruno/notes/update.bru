meta {
  name: Update Note
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/notes/{{noteId}}
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "title": "Quick Capture Idea (Refined)",
    "bodyMarkdown": "Refined content with **updated formatting** and link [[New Architecture]].",
    "summary": "Revised summary",
    "isTodo": false
  }
}

docs {
  Updates note content and re-renders Markdown to HTML.
}
