meta {
  name: Create Quick Note
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/notes
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "title": "Backend Optimization Tasks",
    "level": "Quick",
    "bodyMarkdown": "- [ ] Review SQLite indexes\n- [ ] Benchmark query throughput",
    "summary": "Checklist for performance audit",
    "isTodo": true,
    "tags": [
      {
        "tagType": "FreeForm",
        "value": "backend"
      },
      {
        "tagType": "FreeForm",
        "value": "performance"
      }
    ]
  }
}

docs {
  Creates a Quick note with freeform tags and Todo flag enabled.
}
