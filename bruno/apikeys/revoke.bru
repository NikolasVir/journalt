meta {
  name: Revoke API Key
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/apikeys/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

docs {
  Requires an active session cookie (run Login first).
  Replace the ID in the URL with one from the List response.

  Returns 204 No Content on success.
  Returns 404 if the key does not exist or belongs to another user.
}
