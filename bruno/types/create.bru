meta {
  name: Create Type Definition
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/types
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "name": "BookReview",
    "description": "Template for book reading notes and analysis",
    "schemaJson": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"author\":{\"type\":\"string\"},\"rating\":{\"type\":\"number\",\"minimum\":1,\"maximum\":5}},\"required\":[\"author\"],\"additionalProperties\":false}",
    "sectionsJson": "[{\"heading\":\"Summary\",\"level\":2,\"required\":true,\"allowMultiple\":false},{\"heading\":\"Key Takeaways\",\"level\":2,\"required\":true,\"allowMultiple\":false}]"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("typeId", res.body.id);
  }
}

docs {
  Creates a new Type definition at version 1 (TYPE-001, TYPE-002, TYPE-006).
}
