meta {
  name: Register - Registration Disabled
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@journalt.dev",
    "userName": "admin",
    "password": "password"
  }
}

docs {
  Expects 403 Forbidden.

  To test: set Auth:RegistrationEnabled = false in appsettings.json (or
  set the environment variable Auth__RegistrationEnabled=false) and restart
  the API.
}
