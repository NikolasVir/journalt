meta {
  name: Register - Password Too Short
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@journalt.dev",
    "userName": "admin",
    "password": "abc"
  }
}

docs {
  Expects 400 Bad Request with validation errors array.
  Minimum password length is 6 characters.
}
