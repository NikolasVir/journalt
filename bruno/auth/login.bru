meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@journalt.dev",
    "password": "password",
    "rememberMe": false
  }
}

docs {
  Expects 200 with user (id, userName, email).
  Bruno stores the session cookie automatically — Me and Logout will use it.

  Wrong credentials return 401 with a generic message (intentional — prevents user enumeration).
}
