meta {
  name: Login - Invalid Credentials
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@journalt.dev",
    "password": "wrongpassword",
    "rememberMe": false
  }
}

docs {
  Expects 401 Unauthorized with a generic error message.
  The error text is intentionally vague ("Invalid email or password") to
  prevent user enumeration — the same message is returned whether the email
  does not exist or the password is wrong.
}
