meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@journalt.dev",
    "userName": "admin",
    "password": "password"
  }
}

docs {
  Expects 200 with user (id, userName, email). Session cookie is set automatically.

  Note: select the "local" environment (top-right in Bruno) or {{baseUrl}} will not resolve.
}
