{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "version:gen": "node scripts/set-version.mjs",
    "prestart": "npm run version:gen",
    "start": "ng serve",
    "prebuild": "npm run version:gen",
    "build": "ng build",
    "build:kestrel": "ng build && node -e \"fs.rmSync('../server/src/JournalT.Api/wwwroot', {recursive: true, force: true}); fs.cpSync('dist/client/browser', '../server/src/JournalT.Api/wwwroot', {recursive: true})\"",
    "watch": "ng build --watch --configuration development",
    "test": "npm run version:gen && ng test"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@microsoft/signalr": "^10.0.11",
    "codemirror": "^6.0.2",
    "katex": "^0.18.7",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
